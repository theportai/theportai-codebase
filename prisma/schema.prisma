// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum KYCStatus {
  PENDING
  APPROVED
  REJECTED
}


enum Role {
  USER
  ADMIN
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  email       String?  @unique
  fullName    String?
  pan         String?
  aadhaar     String?
  documentUrl String?
  provider    String    @default("mobile")
  kycStatus   KYCStatus @default(PENDING)
  role        Role      @default(USER)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isVerified  Boolean   @default(false)
}


model OtpRequest {
  id        String   @id @default(uuid())
  phone     String   @unique
  createdAt DateTime @default(now())
}


model CryptoPrice {
  id        String   @id @default(uuid())
  symbol    String
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timestamp DateTime @default(now())
}

model TechnicalIndicators {
  id          Int      @id @default(autoincrement()) // Unique ID
  symbol      String   // BTCUSDT, ETHUSDT, etc.
  timestamp   DateTime @unique // Unique timestamp for each indicator record
  sma_14      Float    // Simple Moving Average (14)
  ema_14      Float    // Exponential Moving Average (14)
  rsi_14      Float    // Relative Strength Index (14)
  macd        Float    // MACD Indicator
  macd_signal Float    // MACD Signal Line
  macd_hist   Float    // MACD Histogram
  bb_high     Float    // Bollinger Bands - Upper Band
  bb_mid      Float    // Bollinger Bands - Middle Band
  bb_low      Float    // Bollinger Bands - Lower Band
  trend       String   @default("Neutral ⚪") // Default: Neutral ⚪

  @@unique([symbol, timestamp]) // Ensure unique records per symbol & timestamp
}